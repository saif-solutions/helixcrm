# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helixcrm?schema=public"

# Security
JWT_SECRET="change-this-to-a-strong-secret-minimum-32-chars"
JWT_REFRESH_SECRET="change-this-to-a-different-strong-secret"
CSRF_SECRET="change-this-csrf-secret"

# Auth
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"
PASSWORD_RESET_TOKEN_EXPIRY="1h"

# Redis
REDIS_URL="redis://localhost:6379"

# App
PORT=3001
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Development
DEV_BYPASS_AUTH=false
NODE_ENV=development
