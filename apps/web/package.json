{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "dev:debug": "cross-env NODE_ENV=development vite --port 3000 --host --debug",
    "dev:inspect": "cross-env NODE_ENV=development vite --port 3000 --host --force",
    "build": "tsc --noEmit && vite build",
    "build:dev": "cross-env NODE_ENV=development vite build",
    "build:prod": "cross-env NODE_ENV=production vite build",
    "build:analyze": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "preview": "vite preview --port 3000 --host",
    "preview:prod": "vite preview --port 3000 --host --mode production",
    "type-check": "tsc --noEmit --skipLibCheck",
    "type-check:watch": "tsc --noEmit --skipLibCheck --watch",
    "type-check:strict": "tsc --noEmit --strict --skipLibCheck",
    "type-check:file": "tsc --noEmit --skipLibCheck --project .",
    "type-check:app": "npm run type-check:file -- --noEmit src/App.tsx 2>&1 | grep -v 'error TS5042'",
    "check": "npm run type-check:file",
    "check:quick": "npm run type-check:file -- --max-warnings 0 | head -50",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix --report-unused-disable-directives --max-warnings 0",
    "lint:staged": "lint-staged",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:components": "vitest run src/components",
    "test:phase2b": "vitest run src/test/phase2B-integration.test.tsx",
    "test:ux": "node scripts/run-tests.js",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:deploy": "npm run storybook:build && gh-pages -d storybook-static",
    "analyze:bundle": "npx vite-bundle-analyzer dist/stats.html",
    "analyze:deps": "npx depcheck",
    "size": "npx bundlesize",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "audit:ci": "npm audit --audit-level=high",
    "outdated": "npm outdated",
    "security": "npm audit && npx snyk test",
    "prepare": "husky",
    "precommit": "npm run lint:staged && npm run type-check",
    "validate": "npm run type-check && npm run lint && npm run test:run",
    "ci": "npm run validate && npm run build",
    "clean": "rimraf dist coverage node_modules/.cache .eslintcache .tsbuildinfo",
    "clean:all": "npm run clean && rimraf node_modules package-lock.json",
    "reinstall": "npm run clean:all && npm install",
    "phase3:test": "npm run type-check && npm run test:phase2b && npm run build",
    "phase3:dev": "npm run dev -- --mode development",
    "phase4:prep": "npm run clean && npm install && npm run build:analyze",
    "generate-types": "openapi-typescript http://localhost:3001/api/docs-json -o src/lib/types/generated/api.ts",
    "prebuild": "npm run generate-types"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tanstack/react-query": "^5.90.19",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.13.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "react-router-dom": "^7.11.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "zod": "^3.22.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.0",
    "@babel/plugin-transform-react-jsx": "7.28.6",
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.39.1",
    "@sentry/react": "10.42.0",
    "@sentry/tracing": "7.120.4",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-actions": "^7.6.17",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/react": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@storybook/test": "^7.6.17",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.7",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.1.11",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jsdom": "^27.4.0",
    "lint-staged": "^15.5.2",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "rollup-plugin-visualizer": "^5.14.0",
    "storybook": "^10.1.11",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-bundle-analyzer": "^1.3.2",
    "vitest": "^4.0.16",
    "vitest-axe": "^0.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
