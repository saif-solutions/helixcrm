# ==================== NODE ENVIRONMENT ====================
NODE_ENV=development
PORT=3001

# ==================== DATABASE ====================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helixcrm_dev"

# ==================== JWT SECRETS ====================
JWT_ACCESS_SECRET=dev_secret_do_not_use_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_do_not_use_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=helixcrm
JWT_AUDIENCE=helixcrm-client

# ==================== REDIS ====================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== CORS ====================
CORS_ORIGIN="http://localhost:3000"

# ==================== ANALYTICS ====================
ANALYTICS_EXPORT_ENABLED=false

# ==================== LOGGING ====================
LOG_LEVEL=debug