# ==================== DATABASE CONFIGURATION ====================
DATABASE_URL='postgresql://username:password@localhost:5432/database?schema=public'

# ==================== JWT CONFIGURATION ====================
JWT_SECRET='change-this-to-a-secure-random-string-minimum-32-characters'
JWT_EXPIRES_IN='15m'
REFRESH_TOKEN_SECRET='different-secure-random-string-from-jwt-secret'
REFRESH_TOKEN_EXPIRES_IN='7d'

# ==================== REDIS CONFIGURATION ====================
REDIS_HOST='localhost'
REDIS_PORT=6379
REDIS_PASSWORD='' # Leave empty if no password
REDIS_TLS=false
REDIS_URL='redis://localhost:6379'

# ==================== ANALYTICS MODULE CONFIGURATION ====================
ANALYTICS_CACHE_TTL=300
ANALYTICS_CACHE_MAX=100
ANALYTICS_EXPORT_ENABLED=true
EXPORT_JOB_ATTEMPTS=3
EXPORT_JOB_TIMEOUT=300000
EXPORT_TOKEN_TTL=900

# ==================== SECURITY CONFIGURATION ====================
CORS_ORIGIN='http://localhost:3000'
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_HTTPONLY=true
CSRF_COOKIE_SAMESITE='lax'
SESSION_COOKIE_MAX_AGE=86400000

# ==================== APPLICATION FEATURES ====================
ENABLE_REGISTRATION=false
DEFAULT_USER_ROLE='user'
ENABLE_MULTI_TENANCY=true
ENABLE_AUDIT_LOGGING=true
ENABLE_SECURITY_HEADERS=true

# ==================== LOGGING CONFIGURATION ====================
LOG_LEVEL='info'
LOG_FORMAT='json'
LOG_SENSITIVE_DATA=false
LOG_REQUEST_ID=true
LOG_PERFORMANCE_METRICS=true

# ==================== ENVIRONMENT SPECIFIC ====================
NODE_ENV='development'
API_PORT=3001
API_HOST='0.0.0.0'
API_PREFIX='/api/v1'
FRONTEND_URL='http://localhost:3000'