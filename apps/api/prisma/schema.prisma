generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  new
  contacted
  qualified
}

enum DealStatus {
  open
  won
  lost
}

// ==================== CORE MODELS ====================
model Organization {
  id       String   @id @default(uuid())
  name     String   @unique
  slug     String   @unique
  status   String   @default("active")
  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Core relations
  User               User[]
  Contact            Contact[]
  Account            Account[]
  Activity           Activity[]
  AuditLog           AuditLog[]
  PasswordResetToken PasswordResetToken[]
  Lead               Lead[]
  
  // Phase 3 relations
  Deal               Deal[]
  Pipeline           Pipeline[]
  Role               Role[]
  UserRole           UserRole[]
  RefreshToken       RefreshToken[]

  @@map("organizations")
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  firstName            String?
  lastName             String?
  passwordHash         String
  role                 String   @default("user")
  isActive             Boolean  @default(true)
  tokenVersion         Int      @default(1)
  emailVerified        Boolean  @default(false)
  lastPasswordResetAt  DateTime?
  failedLoginAttempts  Int      @default(0)
  lockedUntil          DateTime?
  deletedAt            DateTime?
  
  // REFRESH TOKEN SECURITY ENHANCEMENTS:
  refreshTokenHash     String?  @db.VarChar(255)
  refreshTokenVersion  String?  @db.VarChar(255)
  refreshTokenIssuedAt DateTime?
  
  // PHASE 3 ADDITIONS:
  lastPasswordChange   DateTime?  // Track for forced resets
  mustChangePassword   Boolean   @default(false) // For admin-forced changes
  
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastLoginAt DateTime?
  
  // Core relations
  PasswordResetToken PasswordResetToken[]
  Activity           Activity[]
  AuditLog           AuditLog[]
  
  // Phase 3 relations
  OwnedDeals         Deal[]              @relation("DealOwner")
  ChangedStageHistory DealStageHistory[] @relation("StageHistoryChanger")
  UserRoles          UserRole[]
  RefreshTokens      RefreshToken[]      // Added relation

  @@unique([organizationId, email])  // Added for tenant uniqueness
  @@index([organizationId])
  @@index([deletedAt])
  @@index([emailVerified])
  @@index([lockedUntil])
  @@index([refreshTokenHash])
  @@index([refreshTokenVersion])
  @@index([refreshTokenIssuedAt])
  @@index([mustChangePassword])
  @@map("users")
}

// ==================== PHASE 3: REFRESH TOKEN TABLE ====================
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash String   @db.VarChar(512)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, revoked])
  @@index([organizationId])
  @@index([expiresAt])
  @@unique([userId, tokenHash])  // Prevent duplicate tokens
  @@map("refresh_tokens")
}

model Contact {
  id         String  @id @default(uuid())
  firstName  String
  lastName   String
  email      String?
  phone      String?
  title      String?
  department String?
  company    String?
  metadata   Json?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?  // Added soft delete
  deletedBy String?    // Who performed deletion

  // Phase 3 relations
  deals      Deal[]   // Added opposite relation

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, accountId])
  @@index([organizationId, company])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("contacts")
}

model Lead {
  id            String     @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name          String
  email         String?
  phone         String?
  status        LeadStatus @default(new)
  
  metadata      Json?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?  // Added soft delete
  deletedBy     String?    // Who performed deletion
  
  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("leads")
}

model Account {
  id       String  @id @default(uuid())
  name     String
  industry String?
  website  String?
  phone    String?
  email    String?
  address  String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  metadata Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?  // Added soft delete
  deletedBy String?    // Who performed deletion
  
  // Core relations
  Contact   Contact[]
  
  // Phase 3 relations
  deals     Deal[]    // Added opposite relation

  @@index([organizationId])
  @@index([organizationId, name])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("accounts")
}

model Activity {
  id          String  @id @default(uuid())
  type        String
  title       String
  description String?
  status      String  @default("pending")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  relatedToId   String?
  relatedToType String?

  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?  // Added soft delete
  deletedBy   String?    // Who performed deletion

  @@index([organizationId])
  @@index([organizationId, userId])
  @@index([organizationId, type])
  @@index([organizationId, relatedToId, relatedToType])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("activities")
}

model AuditLog {
  id       String  @id @default(uuid())
  action   String
  entity   String
  entityId String?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  before Json?
  after  Json?
  diff   Json?
  correlationId String?
  severity      String  @default("info")

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([correlationId])
  @@index([severity])
  @@map("audit_logs")
}

model PasswordResetToken {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  tokenHash      String   @db.VarChar(255)
  ipAddress      String?
  userAgent      String?
  usedAt         DateTime?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([email])
  @@index([expiresAt])
  @@index([usedAt])
  @@unique([userId, tokenHash])
  @@map("password_reset_tokens")
}

// ==================== DEALS MODELS ====================
model Deal {
  id                  String      @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name                String
  amount              Decimal     @db.Decimal(10, 2)
  currency            String      @default("USD")
  status              DealStatus  @default(open)
  probability         Int         @default(0)
  expectedCloseDate   DateTime?
  
  // ADD THIS FIELD:
  closedAt            DateTime?   // When the deal was closed (won or lost)
  
  pipelineId          String
  pipeline            Pipeline    @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  
  stageId             String
  stage               PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  
  contactId           String?
  contact             Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  
  accountId           String?
  account             Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  
  ownerUserId         String
  owner               User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade, name: "DealOwner")
  
  metadata            Json?
  deletedAt           DateTime?
  deletedBy           String?     // Added who performed deletion
  
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  
  stageHistory        DealStageHistory[]

  @@index([organizationId])
  @@index([organizationId, pipelineId])
  @@index([organizationId, stageId])
  @@index([organizationId, ownerUserId])
  @@index([organizationId, status])
  @@index([organizationId, expectedCloseDate])
  @@index([organizationId, deletedAt])
  @@index([organizationId, closedAt])  // ADD INDEX FOR NEW FIELD
  @@unique([organizationId, pipelineId, name])
  @@map("deals")
}

model Pipeline {
  id              String    @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  isDefault       Boolean   @default(false)
  
  stages          PipelineStage[]
  deals           Deal[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?  // Added soft delete
  deletedBy       String?    // Who performed deletion
  
  @@index([organizationId])
  @@unique([organizationId, name])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("pipelines")
}

model PipelineStage {
  id              String    @id @default(uuid())
  pipelineId      String
  pipeline        Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  order           Int
  probability     Int       @default(0)
  
  deals           Deal[]
  fromStageHistory DealStageHistory[] @relation("fromStage")
  toStageHistory   DealStageHistory[] @relation("toStage")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?  // Added soft delete
  deletedBy       String?    // Who performed deletion
  
  @@unique([pipelineId, order])
  @@index([pipelineId])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("pipeline_stages")
}

model DealStageHistory {
  id              String    @id @default(uuid())
  dealId          String
  deal            Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  
  fromStageId     String?
  fromStage       PipelineStage? @relation(fields: [fromStageId], references: [id], name: "fromStage")
  
  toStageId       String
  toStage         PipelineStage  @relation(fields: [toStageId], references: [id], name: "toStage")
  
  changedByUserId String
  changedBy       User      @relation(fields: [changedByUserId], references: [id], onDelete: Cascade, name: "StageHistoryChanger")
  
  changedAt       DateTime  @default(now())

  @@index([dealId])
  @@index([changedByUserId])
  @@index([changedAt])
  @@map("deal_stage_history")
}

// ==================== RBAC MODELS ====================
model Role {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  isSystem        Boolean       @default(false)
  
  permissions     RolePermission[]
  userRoles       UserRole[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?     // Added soft delete
  deletedBy       String?       // Who performed deletion
  
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("roles")
}

model Permission {
  id              String        @id @default(uuid())
  code            String        @unique
  name            String
  description     String?
  module          String
  
  roles           RolePermission[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@map("permissions")
}

model RolePermission {
  id            String      @id @default(uuid())
  roleId        String
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId  String
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  
  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId        String
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?   // Added soft delete
  deletedBy     String?     // Who performed deletion
  
  @@unique([userId, roleId, organizationId])
  @@index([userId])
  @@index([roleId])
  @@index([organizationId])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("user_roles")
}
