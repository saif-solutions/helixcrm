# Database
DATABASE_URL=postgresql://helix:helix_password_123@localhost:5432/helixcrm

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_this_to_a_secure_random_string

# ==================== ANALYTICS CONFIGURATION ====================
ANALYTICS_CACHE_TTL=300                # Cache TTL in seconds (5 minutes)
ANALYTICS_CACHE_MAX=100                # Maximum cache entries
ANALYTICS_EXPORT_ENABLED=true          # Set to false to disable export functionality

# ==================== EXPORT JOB CONFIGURATION ====================
EXPORT_JOB_ATTEMPTS=3                  # Number of retry attempts for failed exports
EXPORT_JOB_TIMEOUT=300000              # Job timeout in milliseconds (5 minutes)
EXPORT_TOKEN_TTL=900                   # Download token TTL in seconds (15 minutes)

# ==================== REDIS CONFIGURATION (Optional for Phase 3.4) ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                        # Leave empty if no password
REDIS_TLS=false                        # Set to true for TLS connections