generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  new
  contacted
  qualified
}

enum DealStatus {
  open
  won
  lost
}

enum ActorType {
  USER
  SYSTEM
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ==================== CORE MODELS ====================
model Organization {
  id       String   @id @default(uuid())
  name     String   @unique
  slug     String   @unique
  status   String   @default("active")
  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Core relations
  User               User[]
  Contact            Contact[]
  Account            Account[]
  Activity           Activity[]
  AuditLog           AuditLog[]
  PasswordResetToken PasswordResetToken[]
  Lead               Lead[]
  
  // Phase 3 relations
  Deal               Deal[]
  Pipeline           Pipeline[]
  Role               Role[]
  UserRole           UserRole[]
  RefreshToken       RefreshToken[]

exportJobs ExportJob[]
webhooks      Webhook[]
webhookDeliveries WebhookDelivery[]

  @@map("organizations")
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  firstName            String?
  lastName             String?
  passwordHash         String
  role                 String   @default("user")
  isActive             Boolean  @default(true)
  tokenVersion         Int      @default(1)
  emailVerified        Boolean  @default(false)
  lastPasswordResetAt  DateTime?
  failedLoginAttempts  Int      @default(0)
  lockedUntil          DateTime?
  deletedAt            DateTime?
  
  // REFRESH TOKEN SECURITY ENHANCEMENTS:
  refreshTokenHash     String?  @db.VarChar(255)
  refreshTokenVersion  String?  @db.VarChar(255)
  refreshTokenIssuedAt DateTime?
  
  // PHASE 3 ADDITIONS:
  lastPasswordChange   DateTime?  // Track for forced resets
  mustChangePassword   Boolean   @default(false) // For admin-forced changes
  
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastLoginAt DateTime?
  
  // Core relations
  PasswordResetToken PasswordResetToken[]
  Activity           Activity[]
   auditLogs       AuditLog[]   @relation("UserAuditLogs")
  
  // Phase 3 relations
  OwnedDeals         Deal[]              @relation("DealOwner")
  ChangedStageHistory DealStageHistory[] @relation("StageHistoryChanger")
  UserRoles          UserRole[]
  RefreshTokens      RefreshToken[]      // Added relation

  @@unique([organizationId, email])  // Added for tenant uniqueness
  @@index([organizationId])
  @@index([deletedAt])
  @@index([emailVerified])
  @@index([lockedUntil])
  @@index([refreshTokenHash])
  @@index([refreshTokenVersion])
  @@index([refreshTokenIssuedAt])
  @@index([mustChangePassword])
  @@map("users")
}

// ==================== PHASE 3: REFRESH TOKEN TABLE ====================
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash String   @db.VarChar(512)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, revoked])
  @@index([organizationId])
  @@index([expiresAt])
  @@unique([userId, tokenHash])  // Prevent duplicate tokens
  @@map("refresh_tokens")
}

model Contact {
  id         String  @id @default(uuid())
  firstName  String
  lastName  String
  email      String?
  phone      String?
  title      String?
  department String?
  company    String?
  metadata   Json?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?  // Added soft delete
  deletedBy String?    // Who performed deletion

  // Phase 3 relations
  deals      Deal[]   // Added opposite relation

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, accountId])
  @@index([organizationId, company])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("contacts")
}

model Lead {
  id            String     @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name          String
  email         String?
  phone         String?
  status        LeadStatus @default(new)
  
  metadata      Json?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?  // Added soft delete
  deletedBy     String?    // Who performed deletion
  
  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("leads")
}

model Account {
  id       String  @id @default(uuid())
  name     String
  industry String?
  website  String?
  phone    String?
  email    String?
  address  String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  metadata Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?  // Added soft delete
  deletedBy String?    // Who performed deletion
  
  // Core relations
  Contact   Contact[]
  
  // Phase 3 relations
  deals     Deal[]    // Added opposite relation

  @@index([organizationId])
  @@index([organizationId, name])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("accounts")
}

model Activity {
  id          String  @id @default(uuid())
  type        String
  title       String
  description String?
  status      String  @default("pending")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  relatedToId   String?
  relatedToType String?

  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?  // Added soft delete
  deletedBy   String?    // Who performed deletion

  @@index([organizationId])
  @@index([organizationId, userId])
  @@index([organizationId, type])
  @@index([organizationId, relatedToId, relatedToType])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("activities")
}

// ==================== AUDIT LOG ENUMS ====================
enum AuditAction {
  // Auth events
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGE
  TOKEN_REFRESH
  PERFORMANCE_METRIC
  
  // User management
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  ROLE_CHANGED
  
  // Data events
  CONTACT_CREATED
  CONTACT_UPDATED
  CONTACT_DELETED
  DEAL_CREATED
  DEAL_UPDATED
  DEAL_DELETED
  PIPELINE_CREATED
  PIPELINE_UPDATED
  PIPELINE_DELETED
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_DELETED
  
  // System events
  PERMISSION_DENIED
  CSRF_FAILURE
  RATE_LIMIT_TRIGGERED
  SYSTEM_ERROR
  
  // ================ ADDED: ANALYTICS ACTIONS ================
  ANALYTICS_EXPORT_REQUESTED
  ANALYTICS_EXPORT_DOWNLOADED
  ANALYTICS_EXPORT_COMPLETED
  ANALYTICS_EXPORT_FAILED
  
  // ================ ADDED: RBAC ACTIONS ================
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  ROLE_ASSIGNED
  ROLE_REMOVED
  PERMISSION_GRANTED
  PERMISSION_REVOKED
}

enum AuditEntityType {
  AUTH
  USER
  CONTACT
  DEAL
  PIPELINE
  LEAD
  ACCOUNT
  ACTIVITY
  SYSTEM
  // ================ ADDED ENTITY TYPES ================
  ANALYTICS
  ROLE
  PERMISSION
  ORGANIZATION
  SESSION
  TOKEN
  API_KEY
  CONFIGURATION
}

// ==================== AUDIT LOG MODEL ====================
model AuditLog {
  id             String        @id @default(cuid())
  
  // Core fields - USE ENUMS
  action         AuditAction
  entityType     AuditEntityType
  entityId       String?
  organizationId String
  
  // Actor information - USE ENUM
  actorUserId    String?
  actorEmail     String
  actorType      ActorType     @default(USER)
  
  // Request context
  requestId      String?
  correlationId  String?
  
  // Severity - USE ENUM
  severity       AuditSeverity @default(LOW)
  
  // Metadata
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  
  // Timestamps
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  // Relations
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?         @relation(fields: [actorUserId], references: [id], name: "UserAuditLogs")
  
  // Indexes
  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([requestId])
  @@index([correlationId])
  @@index([severity])
  @@index([actorType, createdAt])
  @@index([action])
  @@index([entityType])
  
  @@map("audit_logs")
}

model PasswordResetToken {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  tokenHash      String   @db.VarChar(255)
  ipAddress      String?
  userAgent      String?
  usedAt         DateTime?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([email])
  @@index([expiresAt])
  @@index([usedAt])
  @@unique([userId, tokenHash])
  @@map("password_reset_tokens")
}

// ==================== DEALS MODELS ====================
model Deal {
  id                  String      @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name                String
  amount              Decimal     @db.Decimal(10, 2)
  currency            String      @default("USD")
  status              DealStatus  @default(open)
  probability         Int         @default(0)
  expectedCloseDate   DateTime?
  
  // This field EXISTS in database but was missing from schema
  closedAt            DateTime?   // When the deal was closed (won or lost)
  
  pipelineId          String
  pipeline            Pipeline    @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  
  stageId             String
  stage               PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  
  contactId           String?
  contact             Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  
  accountId           String?
  account             Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  
  ownerUserId         String
  owner               User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade, name: "DealOwner")
  
  metadata            Json?
  deletedAt           DateTime?
  deletedBy           String?     // Added who performed deletion
  
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  
  stageHistory        DealStageHistory[]

  // INDEXES - MUST MATCH DATABASE
  @@index([organizationId])
  @@index([organizationId, pipelineId])
  @@index([organizationId, stageId])
  @@index([organizationId, ownerUserId])
  @@index([organizationId, status])
  @@index([organizationId, expectedCloseDate])
  @@index([organizationId, deletedAt])
  @@index([organizationId, closedAt])  // This index EXISTS in database
  @@unique([organizationId, pipelineId, name])
  @@map("deals")
}

model Pipeline {
  id              String    @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  isDefault       Boolean   @default(false)
  
  stages          PipelineStage[]
  deals           Deal[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?  // Added soft delete
  deletedBy       String?    // Who performed deletion
  
  @@index([organizationId])
  @@unique([organizationId, name])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("pipelines")
}

model PipelineStage {
  id              String    @id @default(uuid())
  pipelineId      String
  pipeline        Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  order           Int
  probability     Int       @default(0)
  
  deals           Deal[]
  fromStageHistory DealStageHistory[] @relation("fromStage")
  toStageHistory   DealStageHistory[] @relation("toStage")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?  // Added soft delete
  deletedBy       String?    // Who performed deletion
  
  @@unique([pipelineId, order])
  @@index([pipelineId])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("pipeline_stages")
}

model DealStageHistory {
  id              String    @id @default(uuid())
  dealId          String
  deal            Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  
  fromStageId     String?
  fromStage       PipelineStage? @relation(fields: [fromStageId], references: [id], name: "fromStage")
  
  toStageId       String
  toStage         PipelineStage  @relation(fields: [toStageId], references: [id], name: "toStage")
  
  changedByUserId String
  changedBy       User      @relation(fields: [changedByUserId], references: [id], onDelete: Cascade, name: "StageHistoryChanger")
  
  changedAt       DateTime  @default(now())

  @@index([dealId])
  @@index([changedByUserId])
  @@index([changedAt])
  @@map("deal_stage_history")
}

// ==================== RBAC MODELS ====================
model Role {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  isSystem        Boolean       @default(false)
  
  permissions     RolePermission[]
  userRoles       UserRole[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?     // Added soft delete
  deletedBy       String?       // Who performed deletion
  
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("roles")
}

model Permission {
  id              String        @id @default(uuid())
  code            String        @unique
  name            String
  description     String?
  module          String
  
  roles           RolePermission[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@map("permissions")
}

model RolePermission {
  id            String      @id @default(uuid())
  roleId        String
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId  String
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  
  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId        String
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  deletedAt     DateTime?   // Added soft delete
  deletedBy     String?     // Who performed deletion
  
  @@unique([userId, roleId, organizationId])
  @@index([userId])
  @@index([roleId])
  @@index([organizationId])
  @@index([deletedAt])  // Added for soft delete queries
  @@map("user_roles")
}
// ==================== ANALYTICS SUMMARY TABLES ====================
// These tables store pre-aggregated data for analytics queries
// Updated via background jobs to avoid hitting operational tables


model RevenueDailySummary {
  id              String      @id @default(uuid())
  organizationId  String      @map("organization_id")
  date            DateTime    @map("date")

  // Revenue metrics
  totalRevenue    Decimal     @db.Decimal(15, 2) @map("total_revenue")
  wonRevenue      Decimal     @db.Decimal(15, 2) @map("won_revenue")
  forecastRevenue Decimal     @db.Decimal(15, 2) @map("forecast_revenue")

  // Counts
  totalDeals      Int         @default(0) @map("total_deals")
  wonDeals        Int         @default(0) @map("won_deals")

  // Derived metrics
  averageDealSize Decimal     @db.Decimal(15, 2) @map("average_deal_size")

  // Currency
  currency        String      @default("USD") @map("currency")

  // Timestamps
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  summarizedAt    DateTime    @default(now()) @map("summarized_at")

  // Indexes
  @@unique([organizationId, date, currency])
  @@index([organizationId, date])
  @@index([summarizedAt])
  @@map("revenue_daily_summaries")
}



// ==================== AUDIT INTEGRITY MODELS ====================
// Append-only audit chain for tamper-evident auditing
model AppendOnlyAuditChain {
  id           String   @id @default(uuid())
  eventHash    String   @map("event_hash")
  previousHash String   @map("previous_hash")
  timestamp    DateTime @default(now())
  blockIndex   Int      @unique @map("block_index")
  metadata     Json?

  @@map("append_only_audit_chain")
  @@index([eventHash])
  @@index([previousHash])
  @@index([blockIndex])
  @@index([timestamp])
}

// Audit integrity verification results
model AuditIntegrityVerification {
  id                     String   @id @default(uuid())
  verificationTimestamp  DateTime @default(now()) @map("verification_timestamp")
  status                 String   // "SUCCESS", "FAILURE", "WARNING"
  totalEvents            Int      @map("total_events")
  brokenAtIndex          Int?     @map("broken_at_index")
  verificationDurationMs Int      @map("verification_duration_ms")
  details                Json?

  @@map("audit_integrity_verification")
  @@index([verificationTimestamp])
  @@index([status])
  @@index([brokenAtIndex])
}


// Add to apps/api/prisma/schema.prisma, after the existing tables:

// ==================== COMPLIANCE EVIDENCE TABLES ====================
model EvidenceCollection {
  id              String   @id @default(uuid())
  collectionId    String   @unique
  collectedAt     DateTime
  totalControls   Int
  criteriaBreakdown Json
  evidencePath    String
  verificationHash String
  status          String   // "COMPLETED", "FAILED", "PARTIAL"
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([collectionId])
  @@index([collectedAt])
  @@index([status])
  @@map("evidence_collections")
}

model EvidenceChain {
  id              String   @id @default(uuid())
  evidenceHash    String   @map("evidence_hash")
  previousHash    String   @map("previous_hash")
  collectionId    String   @map("collection_id")
  evidenceData    Json?    @map("evidence_data")
  
  timestamp       DateTime @default(now())
  
  @@unique([evidenceHash])
  @@index([collectionId])
  @@index([timestamp])
  @@map("evidence_chain")
}

model ControlVerification {
  id              String   @id @default(uuid())
  controlId       String   @map("control_id")
  controlName     String   @map("control_name")
  criteria        String
  verificationDate DateTime @map("verification_date")
  status          String   // "PASS", "FAIL", "PARTIAL"
  evidenceCount   Int      @map("evidence_count")
  verifiedBy      String?  @map("verified_by")
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([controlId])
  @@index([criteria])
  @@index([verificationDate])
  @@index([status])
  @@map("control_verifications")
}

model GapAnalysis {
  id              String   @id @default(uuid())
  analysisDate    DateTime @map("analysis_date")
  totalControls   Int      @map("total_controls")
  completedControls Int    @map("completed_controls")
  partialControls Int      @map("partial_controls")
  missingControls Int      @map("missing_controls")
  overallRisk     String   @map("overall_risk") // "LOW", "MEDIUM", "HIGH"
  reportPath      String   @map("report_path")
  
  createdAt       DateTime @default(now())
  
  @@index([analysisDate])
  @@index([overallRisk])
  @@map("gap_analyses")
}

// ==================== ANALYTICS SUMMARY TABLES ====================
// Daily deal summary for fast analytics
model DealSummaryDaily {
  id              String      @id @default(uuid())
  organizationId  String      @map("organization_id")
  date            DateTime    @map("date")
  
  // Metrics
  dealCount       Int         @default(0) @map("deal_count")
  newDeals        Int         @default(0) @map("new_deals")
  wonDeals        Int         @default(0) @map("won_deals")
  lostDeals       Int         @default(0) @map("lost_deals")
  activeDeals     Int         @default(0) @map("active_deals")
  totalValue      Decimal     @db.Decimal(15, 2) @default(0) @map("total_value")
  averageValue    Decimal     @db.Decimal(15, 2) @default(0) @map("average_value")
  
  // Timestamps
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  summarizedAt    DateTime    @default(now()) @map("summarized_at")
  
  // Indexes
  @@unique([organizationId, date])
  @@index([organizationId, date])
  @@index([summarizedAt])
  @@map("deal_summary_daily")
}

// Daily deal stage summary
model DealStageSummaryDaily {
  id              String      @id @default(uuid())
  organizationId  String      @map("organization_id")
  date            DateTime    @map("date")
  pipelineId      String      @map("pipeline_id")
  stageId         String      @map("stage_id")
  stage           String      @map("stage") // 'LEAD', 'QUALIFIED', 'PROPOSAL', 'NEGOTIATION', 'WON', 'LOST'
  
  // Metrics
  dealCount       Int         @default(0) @map("deal_count")
  totalValue      Decimal     @db.Decimal(15, 2) @default(0) @map("total_value")
  averageValue    Decimal     @db.Decimal(15, 2) @default(0) @map("average_value")
  avgStageDuration Int        @default(0) @map("avg_stage_duration") // in hours
  maxStageDuration Int        @default(0) @map("max_stage_duration") // in hours
  isBottleneck    Boolean     @default(false) @map("is_bottleneck")
  
  // Timestamps
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  summarizedAt    DateTime    @default(now()) @map("summarized_at")
  
  // Indexes
  @@unique([organizationId, date, pipelineId, stageId])
  @@index([organizationId, date])
  @@index([organizationId, pipelineId, stageId])
  @@index([isBottleneck])
  @@map("deal_stage_summary_daily")
}

// Daily revenue summary
model RevenueSummaryDaily {
  id              String      @id @default(uuid())
  organizationId  String      @map("organization_id")
  date            DateTime    @map("date")
  
  // Metrics
  revenue         Decimal     @db.Decimal(15, 2) @default(0) @map("revenue")
  newRevenue      Decimal     @db.Decimal(15, 2) @default(0) @map("new_revenue")
  recurringRevenue Decimal    @db.Decimal(15, 2) @default(0) @map("recurring_revenue")
  churnedRevenue  Decimal     @db.Decimal(15, 2) @default(0) @map("churned_revenue")
  dealCount       Int         @default(0) @map("deal_count")
  averageDealSize Decimal     @db.Decimal(15, 2) @default(0) @map("average_deal_size")
  
  // Timestamps
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  summarizedAt    DateTime    @default(now()) @map("summarized_at")
  
  // Indexes
  @@unique([organizationId, date])
  @@index([organizationId, date])
  @@index([summarizedAt])
  @@map("revenue_summary_daily")
}

// Daily deal forecast summary
model DealForecastSummaryDaily {
  id              String      @id @default(uuid())
  organizationId  String      @map("organization_id")
  date            DateTime    @map("date")
  pipelineId      String?     @map("pipeline_id")
  stageId         String?     @map("stage_id")
  
  // Forecast metrics
  forecastRevenue Decimal     @db.Decimal(15, 2) @default(0) @map("forecast_revenue")
  weightedForecast Decimal    @db.Decimal(15, 2) @default(0) @map("weighted_forecast")
  dealCount       Int         @default(0) @map("deal_count")
  averageProbability Decimal  @db.Decimal(5, 2) @default(0) @map("average_probability")
  
  // Timestamps
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  summarizedAt    DateTime    @default(now()) @map("summarized_at")
  
  // Indexes
  @@unique([organizationId, date, pipelineId, stageId])
  @@index([organizationId, date])
  @@index([organizationId, pipelineId])
  @@index([summarizedAt])
  @@map("deal_forecast_summary_daily")
}

// Daily activity summary (ENHANCED VERSION)
model ActivityDailySummary {
  id              String      @id @default(uuid())
  organizationId  String      @map("organization_id")
  date            DateTime    @map("date")

  // Activity counts by type
  loginCount      Int         @default(0) @map("login_count")
  dealCreated     Int         @default(0) @map("deal_created")
  dealUpdated     Int         @default(0) @map("deal_updated")
  dealWon         Int         @default(0) @map("deal_won")
  dealLost        Int         @default(0) @map("deal_lost")
  contactCreated  Int         @default(0) @map("contact_created")
  contactUpdated  Int         @default(0) @map("contact_updated")
  leadCreated     Int         @default(0) @map("lead_created")
  leadConverted   Int         @default(0) @map("lead_converted")

  // User activity
  activeUsers     Int         @default(0) @map("active_users")
  totalActions    Int         @default(0) @map("total_actions")

  // Timestamps
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  summarizedAt    DateTime    @default(now()) @map("summarized_at")

  // Indexes
  @@unique([organizationId, date])
  @@index([organizationId, date])
  @@index([summarizedAt])
  @@map("activity_daily_summaries")
}

// Pipeline stage summary (for bottleneck detection - ENHANCED VERSION)
model PipelineStageSummary {
  id              String      @id @default(uuid())
  organizationId  String      @map("organization_id")
  pipelineId      String      @map("pipeline_id")
  stageId         String      @map("stage_id")
  date            DateTime    @map("date")

  // Stage metrics
  dealCount       Int         @default(0) @map("deal_count")
  totalAmount     Decimal     @db.Decimal(15, 2) @map("total_amount")
  averageAmount   Decimal     @db.Decimal(15, 2) @map("average_amount")

  // Duration metrics (days)
  avgStageDuration Int        @default(0) @map("avg_stage_duration")
  maxStageDuration Int        @default(0) @map("max_stage_duration")

  // Bottleneck indicator
  isBottleneck    Boolean     @default(false) @map("is_bottleneck")

  // Timestamps
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  summarizedAt    DateTime    @default(now()) @map("summarized_at")

  // Indexes
  @@unique([organizationId, pipelineId, stageId, date])
  @@index([organizationId, date])
  @@index([pipelineId, stageId])
  @@index([isBottleneck])
  @@map("pipeline_stage_summaries")
}


model ExportJob {
  id                  String   @id @default(uuid())
  userId              String
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  exportType          String   // 'contacts', 'deals', 'leads', 'all'
  format              String   // 'csv', 'excel', 'pdf'
  filters             Json?
  options             Json?
  
  status              String   // 'pending', 'processing', 'completed', 'failed', 'cancelled'
  fileUrl             String?
  fileName            String?
  fileSize            Int?
  error               String?
  
  requestedAt         DateTime @default(now())
  processingStartedAt DateTime?
  completedAt         DateTime?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([requestedAt])
  @@index([organizationId, status])
  @@index([organizationId, userId])
  
  @@map("export_jobs")
}


model Webhook {
  id            String   @id @default(uuid())
  name          String   @unique(map: "webhook_name_organization_unique") // Unique within organization
  url           String
  events        String[] // Array of event names, '*' for all events
  secret        String   // For signing payloads
  isActive      Boolean  @default(true)
  retryCount    Int      @default(3)    // Max retry attempts
  timeoutMs     Int      @default(10000) // Request timeout in milliseconds
  headers       Json?    // Custom headers as JSON
  
  // Tenant isolation
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  deliveries   WebhookDelivery[]
  
  // Indexes
  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, isActive])
  @@index([organizationId, createdAt])
  @@unique([organizationId, name], name: "webhook_name_organization_unique")
  @@map("webhooks")
}

model WebhookDelivery {
  id            String   @id @default(uuid())
  
  // Webhook reference
  webhookId     String
  webhook       Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  
  // Delivery details
  event         String   // Event that triggered this delivery
  payload       Json     // Payload sent to webhook
  status        String   // 'pending', 'processing', 'success', 'failed'
  statusCode    Int?     // HTTP status code from webhook response
  response      String?  // Response body from webhook
  error         String?  // Error message if failed
  retryCount    Int      @default(0)
  
  // Timing
  attemptedAt   DateTime @default(now())
  completedAt   DateTime?
  
  // Tenant isolation (via webhook, but denormalized for performance)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Indexes
  @@index([organizationId])
  @@index([webhookId])
  @@index([status])
  @@index([attemptedAt])
  @@index([organizationId, status])
  @@index([organizationId, webhookId])
  @@index([organizationId, attemptedAt])
  @@map("webhook_deliveries")
}