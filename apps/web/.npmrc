# Ensure package-lock.json is used
package-lock=true

# Save exact versions
save-exact=true

# Prefer offline when possible
prefer-offline=true

# Fund messages
fund=false

# Audit level
audit-level=high

# Engine strict
engine-strict=true

# Progress bar
progress=true

# Log level
loglevel=error

# Color output
color=true

# Save dev dependencies exactly
save-dev=true

# Don't generate package-lock for CI (handled separately)
# package-lock=false

# Script prepend node path
scripts-prepend-node-path=true

# Dedupe
prefer-dedupe=true

# Git ignore scripts
ignore-scripts=false

# Legacy peer deps (for React 19 compatibility)
legacy-peer-deps=true