generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                 String               @id @default(uuid())
  name               String               @unique
  slug               String               @unique
  status             String               @default("active")
  settings           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  Account            Account[]
  Activity           Activity[]
  AuditLog           AuditLog[]
  Contact            Contact[]
  Deal               Deal[]
  Lead               Lead[]
  PasswordResetToken PasswordResetToken[]
  Pipeline           Pipeline[]
  RefreshToken       RefreshToken[]
  Role               Role[]
  UserRole           UserRole[]
  User               User[]

  EmailTemplate   EmailTemplate[]
  SentEmail       SentEmail[]
  ExportJob       ExportJob[]
  Webhook         Webhook[]
  WebhookDelivery WebhookDelivery[]
  File            File[]
  ImportJob       ImportJob[]

  @@map("organizations")
}

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  firstName            String?
  lastName             String?
  passwordHash         String
  role                 String               @default("user")
  isActive             Boolean              @default(true)
  organizationId       String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  lastLoginAt          DateTime?
  tokenVersion         Int                  @default(1)
  deletedAt            DateTime?
  emailVerified        Boolean              @default(false)
  failedLoginAttempts  Int                  @default(0)
  lastPasswordResetAt  DateTime?
  lockedUntil          DateTime?
  refreshTokenHash     String?              @db.VarChar(255)
  refreshTokenIssuedAt DateTime?
  refreshTokenVersion  String?              @db.VarChar(255)
  lastPasswordChange   DateTime?
  mustChangePassword   Boolean              @default(false)
  Activity             Activity[]
  auditLogs            AuditLog[]           @relation("UserAuditLogs")
  ChangedStageHistory  DealStageHistory[]   @relation("StageHistoryChanger")
  OwnedDeals           Deal[]               @relation("DealOwner")
  PasswordResetToken   PasswordResetToken[]
  RefreshTokens        RefreshToken[]
  UserRoles            UserRole[]
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([emailVerified])
  @@index([lockedUntil])
  @@index([refreshTokenHash])
  @@index([refreshTokenVersion])
  @@index([refreshTokenIssuedAt])
  @@index([mustChangePassword])
  @@map("users")
}

model RefreshToken {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  tokenHash      String       @db.VarChar(512)
  expiresAt      DateTime
  revoked        Boolean      @default(false)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenHash])
  @@index([userId, revoked])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Contact {
  id             String       @id @default(uuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  title          String?
  department     String?
  organizationId String
  accountId      String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  company        String?
  deletedAt      DateTime?
  deletedBy      String?
  account        Account?     @relation(fields: [accountId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals          Deal[]

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, accountId])
  @@index([organizationId, company])
  @@index([deletedAt])
  @@map("contacts")
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  status         LeadStatus   @default(new)
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  deletedBy      String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([deletedAt])
  @@map("leads")
}

model Account {
  id             String       @id @default(uuid())
  name           String
  industry       String?
  website        String?
  phone          String?
  email          String?
  address        String?
  organizationId String
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  deletedBy      String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Contact        Contact[]
  deals          Deal[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@index([deletedAt])
  @@map("accounts")
}

model Activity {
  id             String       @id @default(uuid())
  type           String
  title          String
  description    String?
  status         String       @default("pending")
  organizationId String
  userId         String
  relatedToId    String?
  relatedToType  String?
  scheduledAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  deletedBy      String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, userId])
  @@index([organizationId, type])
  @@index([organizationId, relatedToId, relatedToType])
  @@index([deletedAt])
  @@map("activities")
}

model AuditLog {
  id             String          @id @default(cuid())
  action         AuditAction
  entityType     AuditEntityType
  entityId       String?
  organizationId String
  actorUserId    String?
  actorEmail     String
  actorType      ActorType       @default(USER)
  requestId      String?
  severity       AuditSeverity   @default(LOW)
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  correlationId  String?
  actor          User?           @relation("UserAuditLogs", fields: [actorUserId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([requestId])
  @@index([correlationId])
  @@index([severity])
  @@index([actorType, createdAt])
  @@index([action])
  @@index([entityType])
  @@index([actorUserId], map: "audit_logs_actor_user_id_idx")
  @@index([requestId], map: "audit_logs_request_id_idx")
  @@map("audit_logs")
}

model PasswordResetToken {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  email          String
  tokenHash      String       @db.VarChar(255)
  ipAddress      String?
  userAgent      String?
  usedAt         DateTime?
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenHash])
  @@index([userId])
  @@index([organizationId])
  @@index([email])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("password_reset_tokens")
}

model Deal {
  id                String             @id @default(uuid())
  organizationId    String
  name              String
  amount            Decimal            @db.Decimal(10, 2)
  currency          String             @default("USD")
  status            DealStatus         @default(open)
  probability       Int                @default(0)
  expectedCloseDate DateTime?
  pipelineId        String
  stageId           String
  contactId         String?
  accountId         String?
  ownerUserId       String
  metadata          Json?
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedBy         String?
  closedAt          DateTime?
  stageHistory      DealStageHistory[]
  account           Account?           @relation(fields: [accountId], references: [id])
  contact           Contact?           @relation(fields: [contactId], references: [id])
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             User               @relation("DealOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  pipeline          Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage             PipelineStage      @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([organizationId, pipelineId, name])
  @@index([organizationId])
  @@index([organizationId, pipelineId])
  @@index([organizationId, stageId])
  @@index([organizationId, ownerUserId])
  @@index([organizationId, status])
  @@index([organizationId, expectedCloseDate])
  @@index([organizationId, deletedAt])
  @@index([organizationId, closedAt])
  @@map("deals")
}

model Pipeline {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  description    String?
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  deletedBy      String?
  deals          Deal[]
  stages         PipelineStage[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])
  @@map("pipelines")
}

model PipelineStage {
  id               String             @id @default(uuid())
  pipelineId       String
  name             String
  description      String?
  order            Int
  probability      Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  deletedBy        String?
  fromStageHistory DealStageHistory[] @relation("fromStage")
  toStageHistory   DealStageHistory[] @relation("toStage")
  deals            Deal[]
  pipeline         Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, order])
  @@index([pipelineId])
  @@index([deletedAt])
  @@map("pipeline_stages")
}

model DealStageHistory {
  id              String         @id @default(uuid())
  dealId          String
  fromStageId     String?
  toStageId       String
  changedByUserId String
  changedAt       DateTime       @default(now())
  changedBy       User           @relation("StageHistoryChanger", fields: [changedByUserId], references: [id], onDelete: Cascade)
  deal            Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage       PipelineStage? @relation("fromStage", fields: [fromStageId], references: [id])
  toStage         PipelineStage  @relation("toStage", fields: [toStageId], references: [id])

  @@index([dealId])
  @@index([changedByUserId])
  @@index([changedAt])
  @@map("deal_stage_history")
}

model Role {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  deletedBy      String?
  permissions    RolePermission[]
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles      UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  module      String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String       @id @default(uuid())
  userId         String
  roleId         String
  organizationId String
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  deletedBy      String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@index([userId])
  @@index([roleId])
  @@index([organizationId])
  @@index([deletedAt])
  @@map("user_roles")
}

model RevenueDailySummary {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  date            DateTime @map("date")
  totalRevenue    Decimal  @map("total_revenue") @db.Decimal(15, 2)
  wonRevenue      Decimal  @map("won_revenue") @db.Decimal(15, 2)
  forecastRevenue Decimal  @map("forecast_revenue") @db.Decimal(15, 2)
  totalDeals      Int      @default(0) @map("total_deals")
  wonDeals        Int      @default(0) @map("won_deals")
  averageDealSize Decimal  @map("average_deal_size") @db.Decimal(15, 2)
  currency        String   @default("USD") @map("currency")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  summarizedAt    DateTime @default(now()) @map("summarized_at")

  @@unique([organizationId, date, currency])
  @@index([organizationId, date])
  @@index([summarizedAt])
  @@map("revenue_daily_summaries")
}

model AppendOnlyAuditChain {
  id           String   @id @default(uuid())
  eventHash    String   @map("event_hash")
  previousHash String   @map("previous_hash")
  timestamp    DateTime @default(now())
  blockIndex   Int      @unique @map("block_index")
  metadata     Json?

  @@index([eventHash])
  @@index([previousHash])
  @@index([blockIndex])
  @@index([timestamp])
  @@map("append_only_audit_chain")
}

model AuditIntegrityVerification {
  id                     String   @id @default(uuid())
  verificationTimestamp  DateTime @default(now()) @map("verification_timestamp")
  status                 String
  totalEvents            Int      @map("total_events")
  brokenAtIndex          Int?     @map("broken_at_index")
  verificationDurationMs Int      @map("verification_duration_ms")
  details                Json?

  @@index([verificationTimestamp])
  @@index([status])
  @@index([brokenAtIndex])
  @@map("audit_integrity_verification")
}

model EvidenceCollection {
  id                String   @id @default(uuid())
  collectionId      String   @unique
  collectedAt       DateTime
  totalControls     Int
  criteriaBreakdown Json
  evidencePath      String
  verificationHash  String
  status            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([collectionId])
  @@index([collectedAt])
  @@index([status])
  @@map("evidence_collections")
}

model EvidenceChain {
  id           String   @id @default(uuid())
  evidenceHash String   @unique @map("evidence_hash")
  previousHash String   @map("previous_hash")
  collectionId String   @map("collection_id")
  evidenceData Json?    @map("evidence_data")
  timestamp    DateTime @default(now())

  @@index([collectionId])
  @@index([timestamp])
  @@map("evidence_chain")
}

model ControlVerification {
  id               String   @id @default(uuid())
  controlId        String   @map("control_id")
  controlName      String   @map("control_name")
  criteria         String
  verificationDate DateTime @map("verification_date")
  status           String
  evidenceCount    Int      @map("evidence_count")
  verifiedBy       String?  @map("verified_by")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([controlId])
  @@index([criteria])
  @@index([verificationDate])
  @@index([status])
  @@map("control_verifications")
}

model GapAnalysis {
  id                String   @id @default(uuid())
  analysisDate      DateTime @map("analysis_date")
  totalControls     Int      @map("total_controls")
  completedControls Int      @map("completed_controls")
  partialControls   Int      @map("partial_controls")
  missingControls   Int      @map("missing_controls")
  overallRisk       String   @map("overall_risk")
  reportPath        String   @map("report_path")
  createdAt         DateTime @default(now())

  @@index([analysisDate])
  @@index([overallRisk])
  @@map("gap_analyses")
}

model DealSummaryDaily {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  date           DateTime @map("date")
  dealCount      Int      @default(0) @map("deal_count")
  newDeals       Int      @default(0) @map("new_deals")
  wonDeals       Int      @default(0) @map("won_deals")
  lostDeals      Int      @default(0) @map("lost_deals")
  activeDeals    Int      @default(0) @map("active_deals")
  totalValue     Decimal  @default(0) @map("total_value") @db.Decimal(15, 2)
  averageValue   Decimal  @default(0) @map("average_value") @db.Decimal(15, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  summarizedAt   DateTime @default(now()) @map("summarized_at")

  @@unique([organizationId, date])
  @@index([organizationId, date])
  @@index([summarizedAt])
  @@map("deal_summary_daily")
}

model DealStageSummaryDaily {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  date             DateTime @map("date")
  pipelineId       String   @map("pipeline_id")
  stageId          String   @map("stage_id")
  stage            String   @map("stage")
  dealCount        Int      @default(0) @map("deal_count")
  totalValue       Decimal  @default(0) @map("total_value") @db.Decimal(15, 2)
  averageValue     Decimal  @default(0) @map("average_value") @db.Decimal(15, 2)
  avgStageDuration Int      @default(0) @map("avg_stage_duration")
  maxStageDuration Int      @default(0) @map("max_stage_duration")
  isBottleneck     Boolean  @default(false) @map("is_bottleneck")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  summarizedAt     DateTime @default(now()) @map("summarized_at")

  @@unique([organizationId, date, pipelineId, stageId])
  @@index([organizationId, date])
  @@index([organizationId, pipelineId, stageId])
  @@index([isBottleneck])
  @@map("deal_stage_summary_daily")
}

model RevenueSummaryDaily {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  date             DateTime @map("date")
  revenue          Decimal  @default(0) @map("revenue") @db.Decimal(15, 2)
  newRevenue       Decimal  @default(0) @map("new_revenue") @db.Decimal(15, 2)
  recurringRevenue Decimal  @default(0) @map("recurring_revenue") @db.Decimal(15, 2)
  churnedRevenue   Decimal  @default(0) @map("churned_revenue") @db.Decimal(15, 2)
  dealCount        Int      @default(0) @map("deal_count")
  averageDealSize  Decimal  @default(0) @map("average_deal_size") @db.Decimal(15, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  summarizedAt     DateTime @default(now()) @map("summarized_at")

  @@unique([organizationId, date])
  @@index([organizationId, date])
  @@index([summarizedAt])
  @@map("revenue_summary_daily")
}

model DealForecastSummaryDaily {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  date               DateTime @map("date")
  pipelineId         String?  @map("pipeline_id")
  stageId            String?  @map("stage_id")
  forecastRevenue    Decimal  @default(0) @map("forecast_revenue") @db.Decimal(15, 2)
  weightedForecast   Decimal  @default(0) @map("weighted_forecast") @db.Decimal(15, 2)
  dealCount          Int      @default(0) @map("deal_count")
  averageProbability Decimal  @default(0) @map("average_probability") @db.Decimal(5, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  summarizedAt       DateTime @default(now()) @map("summarized_at")

  @@unique([organizationId, date, pipelineId, stageId])
  @@index([organizationId, date])
  @@index([organizationId, pipelineId])
  @@index([summarizedAt])
  @@map("deal_forecast_summary_daily")
}

model ActivityDailySummary {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  date           DateTime @map("date")
  loginCount     Int      @default(0) @map("login_count")
  dealCreated    Int      @default(0) @map("deal_created")
  dealUpdated    Int      @default(0) @map("deal_updated")
  dealWon        Int      @default(0) @map("deal_won")
  dealLost       Int      @default(0) @map("deal_lost")
  contactCreated Int      @default(0) @map("contact_created")
  contactUpdated Int      @default(0) @map("contact_updated")
  leadCreated    Int      @default(0) @map("lead_created")
  leadConverted  Int      @default(0) @map("lead_converted")
  activeUsers    Int      @default(0) @map("active_users")
  totalActions   Int      @default(0) @map("total_actions")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  summarizedAt   DateTime @default(now()) @map("summarized_at")

  @@unique([organizationId, date])
  @@index([organizationId, date])
  @@index([summarizedAt])
  @@map("activity_daily_summaries")
}

model PipelineStageSummary {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  pipelineId       String   @map("pipeline_id")
  stageId          String   @map("stage_id")
  date             DateTime @map("date")
  dealCount        Int      @default(0) @map("deal_count")
  totalAmount      Decimal  @map("total_amount") @db.Decimal(15, 2)
  averageAmount    Decimal  @map("average_amount") @db.Decimal(15, 2)
  avgStageDuration Int      @default(0) @map("avg_stage_duration")
  maxStageDuration Int      @default(0) @map("max_stage_duration")
  isBottleneck     Boolean  @default(false) @map("is_bottleneck")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  summarizedAt     DateTime @default(now()) @map("summarized_at")

  @@unique([organizationId, pipelineId, stageId, date])
  @@index([organizationId, date])
  @@index([pipelineId, stageId])
  @@index([isBottleneck])
  @@map("pipeline_stage_summaries")
}

enum LeadStatus {
  new
  contacted
  qualified
}

enum DealStatus {
  open
  won
  lost
}

enum ActorType {
  USER
  SYSTEM
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGE
  TOKEN_REFRESH
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  ROLE_CHANGED
  CONTACT_CREATED
  CONTACT_UPDATED
  CONTACT_DELETED
  DEAL_CREATED
  DEAL_UPDATED
  DEAL_DELETED
  PIPELINE_CREATED
  PIPELINE_UPDATED
  PIPELINE_DELETED
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_DELETED
  PERMISSION_DENIED
  CSRF_FAILURE
  RATE_LIMIT_TRIGGERED
  SYSTEM_ERROR
  PERFORMANCE_METRIC
  ANALYTICS_EXPORT_REQUESTED
  ANALYTICS_EXPORT_DOWNLOADED
  ANALYTICS_EXPORT_COMPLETED
  ANALYTICS_EXPORT_FAILED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  ROLE_ASSIGNED
  ROLE_REMOVED
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  WEBHOOK_CREATED
  WEBHOOK_UPDATED
  WEBHOOK_DELETED
  WEBHOOK_TRIGGERED
  WEBHOOK_RETRY
  WEBHOOK_CLEANUP
}

enum AuditEntityType {
  AUTH
  USER
  CONTACT
  DEAL
  PIPELINE
  LEAD
  ACCOUNT
  ACTIVITY
  SYSTEM
  ANALYTICS
  ROLE
  PERMISSION
  ORGANIZATION
  SESSION
  TOKEN
  API_KEY
  CONFIGURATION
  WEBHOOK
  WEBHOOK_DELIVERY
}

// ========== ADD THESE MODELS ==========

model EmailTemplate {
  id             String       @id @default(uuid())
  name           String
  subject        String
  body           String
  bodyText       String?
  category       String?
  variables      String[]
  isActive       Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sentEmails     SentEmail[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, isActive])
  @@index([deletedAt])
  @@map("email_templates")
}

model SentEmail {
  id             String         @id @default(uuid())
  templateId     String?
  template       EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  to             String
  toName         String?
  cc             Json           @default("[]") @db.JsonB // ✅ FIXED: Changed String[] to Json
  bcc            Json           @default("[]") @db.JsonB // ✅ FIXED: Changed String[] to Json
  subject        String
  body           String
  bodyText       String?
  status         String
  errorMessage   String?
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  campaignId     String?
  contactId      String?
  sentAt         DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@index([organizationId, templateId])
  @@index([organizationId, status])
  @@index([organizationId, sentAt])
  @@index([organizationId, createdAt])
  @@index([userId])
  @@index([campaignId])
  @@index([contactId])
  @@map("sent_emails")
}

model ExportJob {
  id               String       @id @default(uuid())
  type             String
  format           String
  status           String
  fileName         String?
  filePath         String?
  fileSize         Int?
  totalRecords     Int?
  processedRecords Int?
  errorMessage     String?
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?
  expiresAt        DateTime?

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("export_jobs")
}

model Webhook {
  id             String            @id @default(uuid())
  name           String
  url            String
  events         String[]
  secret         String?
  isActive       Boolean           @default(true)
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  // ✅ ADD THESE MISSING FIELDS:
  retryCount Int   @default(3)
  timeoutMs  Int   @default(10000)
  headers    Json? @db.JsonB

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([deletedAt])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String       @id @default(uuid())
  webhookId      String
  webhook        Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  status         String
  statusCode     Int?
  response       String?
  errorMessage   String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attempts       Int          @default(0)
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // ✅ ADD THESE MISSING FIELDS:
  retryCount  Int       @default(0)
  attemptedAt DateTime?
  completedAt DateTime?

  @@index([organizationId])
  @@index([organizationId, webhookId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([nextAttemptAt])
  @@index([attemptedAt])
  @@map("webhook_deliveries")
}

model File {
  id             String       @id @default(uuid())
  filename       String
  originalName   String
  mimeType       String
  size           Int
  path           String
  metadata       Json?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([filename, organizationId])
  @@index([organizationId, deletedAt])
  @@index([userId, deletedAt])
  @@index([mimeType])
  @@index([createdAt])
  @@map("files")
}

model ImportJob {
  id               String       @id @default(uuid())
  type             String
  source           String
  fileName         String?
  fileSize         Int?
  status           String       @default("pending")
  totalRecords     Int?
  processedRecords Int?
  failedRecords    Int?
  errorMessage     String?
  metadata         Json?
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("import_jobs")
}
