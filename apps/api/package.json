{
  "name": "api",
  "version": "0.0.1",
  "description": "HelixCRM API - Enterprise CRM Platform",
  "author": "HelixCRM Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"tests/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test,tests}/**/*.ts\" --fix",
    "==================== TEST RUNNERS ====================": "",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --watch --config jest.config.ts",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --config jest.config.ts",
    "test:list": "jest --listTests --config jest.config.ts",
    "==================== TEST CATEGORIES ====================": "",
    "test:unit": "jest --config jest.config.ts --testPathPattern='tests/unit/.*' --verbose",
    "test:integration": "jest --config jest.config.ts --testPathPattern='tests/integration/.*' --verbose",
    "test:e2e": "jest --config jest.config.ts --testPathPattern='test/.*\\.(e2e-spec|flow\\.spec)\\.ts$' --verbose",
    "test:flows": "jest --config jest.config.ts --testPathPattern='test/flows/.*' --verbose",
    "test:all": "jest --config jest.config.ts --verbose",
    "==================== MODULE-SPECIFIC TESTS ====================": "",
    "test:module:auth": "jest --config jest.config.ts --testPathPattern='(tests/unit/auth/.*|test/flows/auth.*)' --verbose",
    "test:module:users": "jest --config jest.config.ts --testPathPattern='tests/unit/users/.*' --verbose",
    "test:module:leads": "jest --config jest.config.ts --testPathPattern='tests/unit/leads/.*' --verbose",
    "test:module:deals": "jest --config jest.config.ts --testPathPattern='tests/unit/deals/.*' --verbose",
    "test:module:analytics": "jest --config jest.config.ts --testPathPattern='tests/unit/analytics/.*' --verbose",
    "test:module:compliance": "jest --config jest.config.ts --testPathPattern='tests/unit/compliance/.*' --verbose",
    "test:module:contacts": "jest --config jest.config.ts --testPathPattern='tests/unit/contacts/.*' --verbose",
    "test:module:pipelines": "jest --config jest.config.ts --testPathPattern='tests/unit/pipelines/.*' --verbose",
    "test:module:rbac": "jest --config jest.config.ts --testPathPattern='tests/unit/rbac/.*' --verbose",
    "test:module:webhooks": "jest --config jest.ts --testPathPattern='tests/unit/webhooks/.*' --verbose",
    "test:module:export": "jest --config jest.config.ts --testPathPattern='tests/unit/export-queue/.*' --verbose",
    "test:module:email": "jest --config jest.config.ts --testPathPattern='tests/unit/email-templates/.*' --verbose",
    "test:module:file": "jest --config jest.config.ts --testPathPattern='tests/unit/file-storage/.*' --verbose",
    "test:module:dashboard": "jest --config jest.config.ts --testPathPattern='tests/unit/dashboard/.*' --verbose",
    "test:module:import": "jest --config jest.config.ts --testPathPattern='tests/unit/import/.*' --verbose",
    "test:module:audit": "jest --config jest.config.ts --testPathPattern='tests/unit/audit-logs/.*' --verbose",
    "==================== INFRASTRUCTURE TESTS ====================": "",
    "test:guards": "jest --config jest.config.ts --testPathPattern='tests/unit/guards/.*' --verbose",
    "test:decorators": "jest --config jest.config.ts --testPathPattern='tests/unit/decorators/.*' --verbose",
    "test:middleware": "jest --config jest.config.ts --testPathPattern='tests/unit/middleware/.*' --verbose",
    "test:interceptors": "jest --config jest.config.ts --testPathPattern='tests/unit/interceptors/.*' --verbose",
    "test:filters": "jest --config jest.config.ts --testPathPattern='tests/unit/filters/.*' --verbose",
    "==================== COVERAGE TESTS ====================": "",
    "test:cov": "jest --config jest.config.ts --coverage",
    "test:cov:unit": "jest --config jest.config.ts --coverage --testPathPattern='tests/unit/.*'",
    "test:cov:e2e": "jest --config jest.config.ts --coverage --testPathPattern='test/.*'",
    "test:cov:auth": "jest --config jest.config.ts --coverage --testPathPattern='(tests/unit/auth/.*|test/flows/auth.*)'",
    "test:cov:watch": "jest --config jest.config.ts --coverage --watch",
    "test:cov:ci": "jest --config jest.config.ts --coverage --runInBand --maxWorkers=2",
    "==================== CI/CD TESTS ====================": "",
    "test:ci": "jest --config jest.config.ts --runInBand --coverage --maxWorkers=2 --ci --reporters=default --reporters=jest-junit",
    "test:ci:unit": "jest --config jest.config.ts --runInBand --coverage --maxWorkers=2 --testPathPattern='tests/unit/.*' --ci",
    "test:ci:e2e": "jest --config jest.config.ts --runInBand --maxWorkers=2 --testPathPattern='test/.*' --ci",
    "==================== SINGLE FILE TESTS ====================": "",
    "test:file": "jest --config jest.config.ts --testPathPattern",
    "test:file:auth-flow": "jest --config jest.config.ts test/flows/auth.flow.spec.ts --verbose",
    "test:file:app": "jest --config jest.config.ts src/app.controller.spec.ts --verbose",
    "==================== WATCH MODES ====================": "",
    "test:watch:unit": "jest --config jest.config.ts --watch --testPathPattern='tests/unit/.*'",
    "test:watch:e2e": "jest --config jest.config.ts --watch --testPathPattern='test/.*'",
    "test:watch:auth": "jest --config jest.config.ts --watch --testPathPattern='(tests/unit/auth/.*|test/flows/auth.*)'",
    "test:watch:file": "jest --config jest.config.ts --watch --testPathPattern",
    "==================== PERFORMANCE TESTS ====================": "",
    "test:performance": "cd ../.. && ts-node scripts/performance/final-runner.ts",
    "test:performance:smoke": "npm run test:performance -- --smoke",
    "test:performance:quick": "npm run test:performance -- --quick",
    "test:performance:load": "npm run test:performance -- --load",
    "test:performance:stress": "npm run test:performance -- --stress",
    "perf:baseline": "npm run test:performance -- --save-baseline",
    "perf:help": "npm run test:performance -- --help",
    "perf:verify": "cd ../.. && ts-node scripts/performance/verify-setup.ts",
    "==================== COMPLIANCE TESTS ====================": "",
    "compliance:collect": "ts-node scripts/test-compliance.ts",
    "compliance:test": "ts-node -r tsconfig-paths/register scripts/test-compliance.ts",
    "compliance:soc2": "ts-node scripts/compliance/soc2-tests.ts",
    "compliance:gdpr": "ts-node scripts/compliance/gdpr-tests.ts",
    "build:compliance": "tsc -p scripts/compliance/tsconfig.json",
    "==================== DATABASE ====================": "",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:push": "prisma db push --skip-generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "==================== DATABASE TEST UTILITIES ====================": "",
    "db:backup": "ts-node scripts/db/backup.ts",
    "db:restore": "ts-node scripts/db/restore.ts",
    "db:seed:dev": "cross-env NODE_ENV=development tsx prisma/seed.dev.ts",
    "db:seed:test": "cross-env NODE_ENV=test tsx prisma/seed.test.ts",
    "db:seed:prod": "cross-env NODE_ENV=production tsx prisma/seed.prod.ts",
    "db:reset:test": "cross-env NODE_ENV=test prisma migrate reset --force",
    "db:prepare:test": "npm run db:reset:test && npm run db:seed:test",
    "==================== TYPE CHECKING ====================": "",
    "type-check": "tsc --noEmit --skipLibCheck",
    "type-check:watch": "tsc --noEmit --skipLibCheck --watch",
    "type-check:test": "tsc -p tsconfig.spec.json --noEmit",
    "==================== CLEANUP ====================": "",
    "clean": "rimraf dist coverage reports node_modules/.cache",
    "clean:all": "rimraf dist coverage reports node_modules",
    "prebuild": "npm run clean",
    "postinstall": "prisma generate",
    "==================== VALIDATION ====================": "",
    "validate": "npm run type-check && npm run lint && npm run test:unit",
    "validate:ci": "npm run type-check && npm run lint && npm run test:ci",
    "validate:all": "npm run type-check && npm run lint && npm run test:all",
    "validate:with-cov": "npm run type-check && npm run lint && npm run test:cov",
    "==================== DEVELOPMENT ====================": "",
    "dev": "npm run start:dev",
    "dev:debug": "npm run start:debug",
    "==================== REPORTING ====================": "",
    "report:coverage": "open coverage/lcov-report/index.html",
    "report:test": "open reports/junit/jest-junit.xml",
    "report:performance": "open reports/performance/latest/index.html"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.20.3",
    "@bull-board/express": "^6.20.3",
    "@helixcrm/auth-core": "file:../../packages/auth-core",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^7.4.2",
    "@sentry/nestjs": "^10.42.0",
    "@sentry/node": "^10.42.0",
    "@sentry/profiling-node": "^10.42.0",
    "@sentry/tracing": "^7.120.4",
    "axios": "^1.13.6",
    "bullmq": "^5.70.4",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cross-env": "^10.1.0",
    "csurf": "^1.11.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "joi": "^18.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.16",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/csurf": "^1.11.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.3.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.8.1",
    "prisma": "^7.4.2",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "jest": {}
}
