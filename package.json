{
  "name": "helixcrm",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "jest",
    "test:unit": "jest --selectProjects unit:api unit:web",
    "test:unit:api": "jest --selectProjects unit:api",
    "test:unit:web": "jest --selectProjects unit:web",
    "test:integration": "jest --selectProjects integration",
    "test:security": "jest --selectProjects security",
    "test:contract": "jest --selectProjects contracts",
    "test:e2e": "jest --selectProjects e2e",
    "test:critical": "jest --testNamePattern='@critical'",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --maxWorkers=50% --coverage",
    "test:containers:start": "./scripts/start-test-containers.sh",
    "test:containers:stop": "./scripts/stop-test-containers.sh",
    "test:cov": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}